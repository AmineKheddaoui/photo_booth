# Copiez ce fichier vers .env. Ne versionnez jamais le fichier .env.
ADMIN_USER=admin
# OBLIGATOIRE : remplacez CHANGE_ME (rejeté au démarrage) par un secret unique.
# Générez-le avec : openssl rand -hex 24
# Minimum 16 caractères ; aucune valeur utilisable n'est fournie ici.
ADMIN_PASSWORD=CHANGE_ME

# Exemple local accepté en production ; utilisez HTTPS pour un déploiement réel.
# Pour Internet : PUBLIC_URL=https://photos.example.com
PUBLIC_URL=http://localhost:3000
EVENT_NAME=
SLIDESHOW_INTERVAL_MS=7000

# 0 par défaut. 1 UNIQUEMENT derrière exactement un reverse proxy de confiance.
TRUST_PROXY=0

# Loopback par défaut. Pour le LAN : adresse IP locale, ou 0.0.0.0 (toutes interfaces).
# Adaptez également PUBLIC_URL à l'adresse accessible par les invités.
HOST_BIND=127.0.0.1
