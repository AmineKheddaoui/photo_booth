{
  "name": "wedding-photo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Collecte auto-hébergée de photos de mariage",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i public/css/tailwind.input.css -o public/css/tailwind.css --minify",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "node test/browser-smoke.js",
    "check": "node --check server.js && node --check public/js/common.js && node --check public/js/guest.js && node --check public/js/admin.js && node --check public/js/slideshow.js"
  },
  "dependencies": {
    "alpinejs": "^3.15.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.19",
    "yauzl": "^3.2.0"
  }
}
